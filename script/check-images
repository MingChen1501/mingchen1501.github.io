#!/bin/sh
# CI guard for #19 / #33: fail when a new image is too large or assets/img exceeds budget.
# Limits: single image <= 500KB, whole assets/img <= 6MB (budget bumped from 5MB per #33 policy).
set -e

MAX_FILE_BYTES=512000
MAX_TOTAL_BYTES=6291456

fail=0

echo "Checking individual image sizes (limit 500KB)..."
# shellcheck disable=SC2086
oversized="$(find assets/img -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' \) -size +500k -print 2>/dev/null || true)"
if test -n "$oversized"; then
  echo "ERROR: images over 500KB (MAX_FILE_BYTES=$MAX_FILE_BYTES):"
  echo "$oversized" | while IFS= read -r f; do
    ls -lh "$f"
  done
  fail=1
else
  echo "OK: all images <= 500KB."
fi

echo "Checking total assets/img size (limit 6MB)..."
total_bytes="$(du -sb assets/img | cut -f1)"
echo "assets/img total: $total_bytes bytes ($(du -sh assets/img | cut -f1))"
if test "$total_bytes" -gt "$MAX_TOTAL_BYTES"; then
  echo "ERROR: assets/img exceeds 6MB budget (MAX_TOTAL_BYTES=$MAX_TOTAL_BYTES, actual=$total_bytes)."
  fail=1
else
  echo "OK: assets/img within 6MB budget."
fi

if test "$fail" -ne 0; then
  echo "Image size check FAILED."
  exit 1
fi
echo "Image size check passed."

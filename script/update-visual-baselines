#!/bin/sh
# Regenerate the Playwright visual-regression baselines (#208) after an
# intentional visual change. Reviews the diff before committing: run the suite
# once normally to see which captures changed, then run this script.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

UPDATE_BASELINES=1 python3 -m pytest "$ROOT/tests/e2e/test_visual_regression.py" -q

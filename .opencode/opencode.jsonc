{
  // Project config cho OpenCode (tự load từ .opencode/opencode.jsonc).
  // Chi tiết field: https://opencode.ai/v2/docs/config
  "$schema": "https://opencode.ai/config.json",

  // Quy tắc hỏi/cho phép theo thứ tự: rule khớp CUỐI CÙNG thắng.
  "permissions": [
    // Mặc định: shell hỏi trước khi chạy.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Đọc/tìm kiếm luôn được phép.
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },

    // Git chỉ đọc: cho phép không cần hỏi.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },

    // Build + test của site này: cho phép không cần hỏi.
    { "action": "shell", "resource": "bundle exec jekyll build *", "effect": "allow" },
    { "action": "shell", "resource": "python -m pytest *", "effect": "allow" },

    // Đẩy code luôn phải xác nhận, kể cả khi có rule allow rộng hơn ở trên.
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ]
}

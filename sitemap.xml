---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% assign site_url = site.url | strip %}

  <!-- Homepage (English default) with its Vietnamese alternate (#93/#98). -->
  <url>
    <loc>{{ site_url }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% include sitemap-alternates.html ref="home" %}
  </url>

  <!-- Vietnamese homepage: same `ref: home`, the `vi` side of the pair. -->
  <url>
    <loc>{{ site_url }}/vi/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% include sitemap-alternates.html ref="home" %}
  </url>

  {% comment %} Paginated list pages (/page2/ ... /pageN/). `paginator` is bound
    only on the paginated index.html, never on this standalone page, so derive
    the page count from site.posts.size and site.paginate with ceil division and
    enumerate the pages explicitly (emitted only when the count is >= 2).
    Alternates mirror the head on those pages (#93): both sides (and the
    x-default) point at the first pages, never at a page-N URL.
  {% endcomment %}
  {% assign paginate_per_page = site.paginate | default: 0 | plus: 0 %}
  {% if paginate_per_page > 0 %}
    {% assign post_count = site.posts | size %}
    {% assign total_pages = post_count | plus: paginate_per_page | minus: 1 | divided_by: paginate_per_page %}
    {% if total_pages > 1 %}
      {% for page_num in (2..total_pages) %}
  <url>
    <loc>{{ site_url }}/page{{ page_num }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% include sitemap-alternates.html ref="home" %}
  </url>
      {% endfor %}
    {% endif %}
  {% endif %}

  {% comment %} Paginated Vietnamese home (/vi/page2/ ... /vi/pageN/, #155).
    Plain `for` over the collection degrades to nothing when it is undefined
    (the upstream `_config_theme-dev.yml` CI build in `script/cibuild`), and
    `size` on nil is 0, so no explicit nil-guard is needed. Pages are
    enumerated from the collection size with ceil division over the same
    5-posts-per-page constant as `_layouts/home.html`; a page-N URL listed
    here must resolve to a built `vi/pageN/index.html` file (guarded by
    `test_sitemap_xml_parses_and_urls_match_site_files`), so adding an 11th
    VI post fails the suite until `vi/page3/index.html` is created.
    Alternates mirror the head on those pages (#93): both sides (and the
    x-default) point at the first pages, never at a page-N URL.
  {% endcomment %}
  {% assign vi_per_page = 5 %}
  {% assign vi_post_count = site.vi_posts | size %}
  {% assign vi_total_pages = vi_post_count | plus: vi_per_page | minus: 1 | divided_by: vi_per_page %}
  {% if vi_total_pages > 1 %}
    {% for vi_page_num in (2..vi_total_pages) %}
  <url>
    <loc>{{ site_url }}/vi/page{{ vi_page_num }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% include sitemap-alternates.html ref="home" %}
  </url>
    {% endfor %}
  {% endif %}

  {% comment %} Static pages: single emission path for /tags/, /about/,
    /resume/ (layout: page with a permalink); 404/feed/sitemap/llms are
    never emitted. Both languages are in site.pages already (`vi/*.md` carry
    `/vi/...` permalinks); each entry links its counterpart via the shared ref.
  {% endcomment %}
  {% for page in site.pages %}
    {% if page.layout == "page" and page.permalink %}
      {% unless page.url contains "404" or page.url contains "feed.xml" or page.url contains "sitemap.xml" or page.url contains "llms.txt" %}
  <url>
    <loc>{{ site_url }}{{ page.permalink }}</loc>
    {% if page.date %}
    <lastmod>{{ page.date | date_to_xmlschema }}</lastmod>
    {% elsif page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {% elsif site.time %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% endif %}
    {% include sitemap-alternates.html ref=page.ref %}
  </url>
      {% endunless %}
    {% endif %}
  {% endfor %}

  {% comment %} Pillar tag pages: single emission path over the tags/<tag>.md
    pages (layout: tag), one <loc> per page, in both languages (the `vi/`
    mirrors carry the same `ref: tag-<pillar>`). {% endcomment %}
  {% for tag_page in site.pages %}
    {% if tag_page.layout == "tag" and tag_page.permalink %}
  <url>
    <loc>{{ site_url }}{{ tag_page.permalink }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% include sitemap-alternates.html ref=tag_page.ref %}
  </url>
    {% endif %}
  {% endfor %}

  {% comment %} English posts: single emission path over site.posts (published
    only), each entry linking its Vietnamese translation via the shared ref.
  {% endcomment %}
  {% for post in site.posts %}
    {% if post.url %}
  <url>
    <loc>{{ site_url }}{{ post.url }}</loc>
    {% if post.date %}
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    {% elsif post.last_modified_at %}
    <lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>
    {% elsif site.time %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% endif %}
    {% include sitemap-alternates.html ref=post.ref %}
  </url>
    {% endif %}
  {% endfor %}

  {% comment %} Vietnamese posts: the `site.vi_posts` collection (`/vi/...`
    permalinks), each entry linking its English original via the shared ref.
    A plain `for` loop degrades to nothing when the collection is undefined
    (the upstream `_config_theme-dev.yml` CI build in `script/cibuild`).
  {% endcomment %}
  {% for vi_post in site.vi_posts %}
    {% if vi_post.url %}
  <url>
    <loc>{{ site_url }}{{ vi_post.url }}</loc>
    {% if vi_post.date %}
    <lastmod>{{ vi_post.date | date_to_xmlschema }}</lastmod>
    {% elsif vi_post.last_modified_at %}
    <lastmod>{{ vi_post.last_modified_at | date_to_xmlschema }}</lastmod>
    {% elsif site.time %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% endif %}
    {% include sitemap-alternates.html ref=vi_post.ref %}
  </url>
    {% endif %}
  {% endfor %}
</urlset>

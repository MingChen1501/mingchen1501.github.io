---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign site_url = site.url | strip %}

  <!-- Homepage -->
  <url>
    <loc>{{ site_url }}/</loc>
    {% if site.time %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>

  {% comment %} Find paginated pages (GitHub Pages uses jekyll-paginate: /page2/, /page3/, ...) {% endcomment %}
  {% assign max_pages = 1000 %}
  {% for i in (2..max_pages) %}
    {% assign page_path = "/page" | append: i | append: "/" %}
    {% comment %} Check if page exists in paginator.pages would be ideal, but in build paginator is available? For static rendering, check site.paginate_path structure is fixed. Also look for actual generated paths: better to enumerate by trying to see if corresponding index page conceptually exists - but easier to detect from paginator if present {% endcomment %}
    {% break if i > 10 %}{% comment %} safe upper bound since paginate is 5 and only 7 posts total {% endcomment %}
  {% endfor %}
  {% if paginator and paginator.total_pages > 1 %}
    {% for i in (2..paginator.total_pages) %}
      <url>
        <loc>{{ site_url }}/page{{ i }}/</loc>
        {% if site.time %}
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endfor %}
  {% endif %}

  <!-- Tags index -->
  <url>
    <loc>{{ site_url }}/tags/</loc>
    {% if site.time %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>

  <!-- Pillar tag pages -->
  {% for tag in site.tags %}
    {% assign tag_name = tag[0] %}
    <url>
      <loc>{{ site_url }}/tags/{{ tag_name | slugify: "pretty" }}/</loc>
      {% if site.time %}
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      {% endif %}
    </url>
  {% endfor %}
  {% for tag_page in site.pages %}
    {% if tag_page.layout == "tag" and tag_page.permalink %}
      {% unless tag_page.permalink contains "/404" %}
        <url>
          <loc>{{ site_url }}{{ tag_page.permalink }}</loc>
          {% if site.time %}
          <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
          {% endif %}
        </url>
      {% endunless %}
    {% endif %}
  {% endfor %}

  <!-- Static pages -->
  {% for page in site.pages %}
    {% if page.layout == "page" and page.permalink %}
      {% unless page.url contains "404" or page.url contains "feed.xml" or page.url contains "sitemap.xml" or page.url contains "llms.txt" %}
        <url>
          <loc>{{ site_url }}{{ page.permalink }}</loc>
          {% if page.date %}
            <lastmod>{{ page.date | date_to_xmlschema }}</lastmod>
          {% elsif page.last_modified_at %}
            <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
          {% elsif site.time %}
            <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
          {% endif %}
        </url>
      {% endunless %}
    {% endif %}
  {% endfor %}
  {% for page in site.html_pages %}
    {% if page.layout == "page" and page.permalink %}
      {% unless page.url contains "404" or page.url contains "feed.xml" or page.url contains "sitemap.xml" or page.url contains "llms.txt" %}
        <url>
          <loc>{{ site_url }}{{ page.permalink }}</loc>
          {% if site.time %}
            <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
          {% endif %}
        </url>
      {% endunless %}
    {% endif %}
  {% endfor %}

  <!-- Posts -->
  {% for post in site.posts %}
    {% if post.url %}
      <url>
        <loc>{{ site_url }}{{ post.url }}</loc>
        {% if post.date %}
          <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
        {% elsif post.last_modified_at %}
          <lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>
        {% elsif site.time %}
          <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endif %}
  {% endfor %}
</urlset>
